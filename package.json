{
  "name": "awitloop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turn any TV into a karaoke room. Phones are the songbook.",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "npm run typecheck && vite build",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker"
  },
  "license": "MIT",
  "repository": "github:phcodesage/awitloop",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "@vitejs/plugin-legacy": "^8.2.3",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "wrangler": "^4.143.0"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  }
}
